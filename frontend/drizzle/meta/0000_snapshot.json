          "value": "\"bookings\".\"start_time\" >= 480 AND \"bookings\".\"end_time\" <= 1320 AND \"bookings\".\"end_time\" - \"bookings\".\"start_time\" BETWEEN 30 AND 240 AND \"bookings\".\"starts_at\" < \"bookings\".\"ends_at\""
